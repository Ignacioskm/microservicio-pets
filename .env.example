# Copia este archivo a ".env" (NO lo subas a Git) y cambia los valores.
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_USER=vitalpet
DB_PASSWORD=cambia_esta_clave

# ── Integración con ms-users (compañero) ──
# false = ms-pets funciona solo, acepta cualquier ownerId.
# true  = valida contra ms-users que el dueño exista y sea cliente.
USERS_VALIDATION_ENABLED=false
# URL de ms-users (IP pública/privada de la EC2 de tu compañero), solo se usa si lo de arriba es true
USERS_SERVICE_URL=http://IP_DE_MS_USERS:8082

# ── CORS ──
# "*" permite cualquier origen. En producción pon el origen del front, ej: http://mi-front.com
CORS_ALLOWED_ORIGINS=*
